{
  "name": "cloud-file-share",
  "version": "2.0.0",
  "description": "Aplicación cliente-servidor en la nube: almacenamiento y compartición de archivos con HTTPS, SFTP y SQLite",
  "main": "server.js",
  "scripts": {
    "generate-cert": "node generate-cert.js",
    "start": "node server.js",
    "dev": "node server.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "verify": "node scripts/verify-app.js",
    "verify:local": "node scripts/verify-app.js https://localhost:8443"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "selfsigned": "^2.4.1",
    "ssh2": "^1.16.0"
  }
}
